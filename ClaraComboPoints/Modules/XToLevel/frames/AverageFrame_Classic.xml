<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/..\..\FrameXML\UI.xsd"> 

<Script file="AverageFrame_Classic.lua"/>

<!-- Templates -->
<FontString name="ClaraXToLevel_h1" inherits="SystemFont_Med1" justifyH="LEFT" virtual="true">
    <Color r="0.25" g="1.0" b="0.5" a="1.0"/>
    <Shadow><Offset x="1" y="-1"/><Color r="0" g="0" b="0" a="1.0"/></Shadow>
</FontString>
<FontString name="ClaraXToLevel_span" inherits="GameTooltipTextSmall" justifyH="LEFT" virtual="true">
    <Shadow><Offset x="1" y="-1"/><Color r="0" g="0" b="0" a="1.0"/></Shadow>
</FontString>

<!-- Main frame -->
<Frame name="ClaraXToLevel_AverageFrame_Classic_Template" virtual="true" frameStrata="LOW" enableMouse="true" resizable="false" movable="true" clampedToScreen="true" hidden="false">
	<Anchors>
		<Anchor point="TOP" relativeTo="UIParent" relativePoint="TOP"> <!-- (Clara Combo Points: the top's middle) -->
			<Offset x="0" y="-1" />
		</Anchor>
    </Anchors>
	<Scripts>
		<OnLoad>
            self:RegisterForDrag("LeftButton");
		</OnLoad>
        <OnMouseUp>
			if XToLevel.db.profile.general.allowSettingsClick and button == "RightButton" then
				XToLevel.Config:Open("Window")
			end
		</OnMouseUp>
		<OnEvent>
			XToLevel.AverageFrameAPI["Classic"]:OnEvent();
		</OnEvent>
		<OnDragStart>
            XToLevel.AverageFrameAPI["Classic"]:StartDrag();
		</OnDragStart>
		<OnDragStop>
			XToLevel.AverageFrameAPI["Classic"]:StopDrag()
		</OnDragStop>
    </Scripts>
</Frame>

</Ui>