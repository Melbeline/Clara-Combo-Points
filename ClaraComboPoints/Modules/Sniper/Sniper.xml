<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\..\FrameXML\UI.xsd">
	<!-- Clara Combo Points: the sniper's tab, in Auctionator's tab strip of the auction house (Sniper.lua registers
	     it there; built as Auctionator's own tabs are: on the auction house, over its content) -->
	<Frame name="ClaraSniperTabFrameTemplate" virtual="true" hidden="true">
		<Anchors>
			<Anchor point="TOPLEFT" x="4" y="0"/>
			<Anchor point="BOTTOMRIGHT" x="-4" y="27"/>
		</Anchors>
		<Scripts>
			<OnLoad>
				if ClaraSniper_OnLoad then ClaraSniper_OnLoad(self) end
			</OnLoad>
		</Scripts>
	</Frame>
</Ui>
