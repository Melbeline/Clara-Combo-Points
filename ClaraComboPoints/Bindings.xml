<Bindings>

	<!-- Fishing (Fishing.lua): casts Fishing; while the line is out the key is the game's Interact Key -->
	<Binding name="CLICK ClaraFishingButton:LeftButton" category="BINDING_CATEGORY_CLARA"></Binding>

	<!-- UnitScan (UnitScan.lua): /targetexact the hunted mob, one press one target -->
	<Binding name="CLICK ClaraScanHunt:LeftButton" category="BINDING_CATEGORY_CLARA"></Binding>

	<!-- Leatrix Plus (embedded, or the standalone when it runs: both answer to SlashCmdList["Leatrix_Plus"]) -->
	<Binding name="CLARA_LEAPLUS_TOGGLE" category="BINDING_CATEGORY_CLARA_QOL">
		if SlashCmdList["Leatrix_Plus"] then SlashCmdList["Leatrix_Plus"]() end
	</Binding>
	<Binding name="CLARA_LEAPLUS_RARE" category="BINDING_CATEGORY_CLARA_QOL">
		if SlashCmdList["Leatrix_Plus"] then SlashCmdList["Leatrix_Plus"]("ra") end
	</Binding>
	<Binding name="CLARA_LEAPLUS_MOUNTSPECIAL" category="BINDING_CATEGORY_CLARA_QOL">
		if not C_RestrictedActions.IsAddOnRestrictionActive(Enum.AddOnRestrictionType.Chat) then
			DoEmote('mountspecial')
		end
	</Binding>

	<!-- Leatrix Plus flares (the built-in copy's buttons: named apart from the standalone's, whose
	     own Bindings.xml declares those) -->
	<Binding name="CLICK ClaraLeaPlusFlare1:LeftButton" category="BINDING_CATEGORY_CLARA_QOL"></Binding>
	<Binding name="CLICK ClaraLeaPlusFlare2:LeftButton" category="BINDING_CATEGORY_CLARA_QOL"></Binding>
	<Binding name="CLICK ClaraLeaPlusFlare3:LeftButton" category="BINDING_CATEGORY_CLARA_QOL"></Binding>
	<Binding name="CLICK ClaraLeaPlusFlare4:LeftButton" category="BINDING_CATEGORY_CLARA_QOL"></Binding>
	<Binding name="CLICK ClaraLeaPlusFlare5:LeftButton" category="BINDING_CATEGORY_CLARA_QOL"></Binding>
	<Binding name="CLICK ClaraLeaPlusFlare6:LeftButton" category="BINDING_CATEGORY_CLARA_QOL"></Binding>
	<Binding name="CLICK ClaraLeaPlusFlare7:LeftButton" category="BINDING_CATEGORY_CLARA_QOL"></Binding>
	<Binding name="CLICK ClaraLeaPlusFlare8:LeftButton" category="BINDING_CATEGORY_CLARA_QOL"></Binding>
	<Binding name="CLICK ClaraLeaPlusFlare9:LeftButton" category="BINDING_CATEGORY_CLARA_QOL"></Binding>

	<!-- LFG Forever (built in, or the standalone when it runs: both define LFGForever_ToggleWindow) -->
	<Binding name="CLARA_LFGFOREVER_TOGGLE" category="BINDING_CATEGORY_CLARA_QOL">
		if LFGForever_ToggleWindow then LFGForever_ToggleWindow() end
	</Binding>


</Bindings>
